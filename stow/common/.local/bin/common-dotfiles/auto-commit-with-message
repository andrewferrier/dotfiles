#!/usr/bin/env python

import argparse
import logging
import os
import subprocess
import sys
from pathlib import Path

logger = logging.getLogger("auto-commit-with-message")
syserr_handler = logging.StreamHandler(stream=sys.stderr)
syserr_handler.setFormatter(logging.Formatter("%(name)s: %(levelname)s: %(message)s"))
logger.addHandler(syserr_handler)

parser = argparse.ArgumentParser()
parser.add_argument(
    "--dry-run",
    action="store_true",
)
parser.add_argument(
    "--verbose",
    action="store_true",
)
args = parser.parse_args()

IGNORE_COMPONENTS: list[str] = ["cur", "email", "emails", "new", "tmp"]


def get_staged_files() -> list[Path]:
    result = subprocess.run(
        ["/usr/bin/git", "diff", "--cached", "--name-only"],
        capture_output=True,
        text=True,
        check=True,
    )
    return [Path(line) for line in result.stdout.splitlines() if line]


def build_commit_message(staged_files: list[Path]) -> str:
    dirs = [p.parent for p in staged_files]

    if len(dirs) == 1:
        common = dirs[0]
    else:
        common = Path(os.path.commonpath([str(d) for d in dirs]))

    filtered_parts = [p for p in common.parts if p not in IGNORE_COMPONENTS]
    return str(Path(*filtered_parts)) if filtered_parts else str(common)


def main() -> None:
    if args.verbose:
        logger.setLevel(logging.DEBUG)
        syserr_handler.setLevel(logging.DEBUG)

    staged_files = get_staged_files()

    if not staged_files:
        logger.error("No staged files found. Stage files before committing.")
        sys.exit(1)

    message = build_commit_message(staged_files)

    if args.dry_run:
        print(message)  # noqa: T201
        return

    logger.info(f"Using commit message: {message!r}")

    subprocess.run(["/usr/bin/git", "commit", "-m", message], check=True)  # noqa: S603


main()
